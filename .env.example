# Database
# PostgreSQL connection string; replace with a database you control.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"
# bun dev starts local PostgreSQL in Docker only when this URL points to it.
# Docker Compose local database (Compose sets this URL for the app service):
# postgresql://rapidauth:rapidauth@localhost:5432/rapidauth?sslmode=disable

# Better Auth
# Replace with a unique 64-character secret from: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-with-a-unique-random-64-character-hex-secret"
# Public base URL of this app.
BETTER_AUTH_URL="http://localhost:3000"

# Scheduled cleanup (optional)
# Leave empty to disable /api/cron/cleanup. When enabled, use at least 32 random characters.
CRON_SECRET=""

# Client IP trust
# none (default), vercel, cloudflare, or proxy. See docs/en/07-scheduled-cleanup.md.
TRUSTED_PROXY="none"

# Email (Resend)
# With an API key from your Resend account, emails are sent through Resend.
# Without one, they go to Mailpit, a local inbox at http://localhost:8025.
RESEND_API_KEY=""
# Use an address on a domain verified with Resend for production.
FROM_EMAIL="RapidAuth <noreply@example.com>"

# Support
# Public support and legal contact email. Required for production builds.
SUPPORT_EMAIL=""

# Cloudflare Turnstile
# Optional. Turnstile turns on only when both keys are set; leave both empty to turn it off.
# Turning it on in production is recommended. Read when the server starts, no rebuild needed.
# Site key: public, sent to the browser. Test keys: docs/en/02-turnstile.md
TURNSTILE_SITE_KEY=""
# Secret key: server only, never expose it to the client.
TURNSTILE_SECRET_KEY=""

# Error monitoring (Sentry, optional)
# Public DSN used by both browser and server. Leave empty to disable Sentry completely.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional build-only values for uploading source maps.
SENTRY_ORG=""
SENTRY_PROJECT=""
# Secret build token. Never expose it to the browser or commit it.
SENTRY_AUTH_TOKEN=""
# 0 reports errors only; use a value from 0 to 1 to sample performance traces.
SENTRY_TRACES_SAMPLE_RATE="0"

# OAuth Providers
# Optional. Google sign-in (and its button) turns on only when both values are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional. GitHub sign-in (and its button) turns on only when both values are set.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Avatar file storage
# local stores files under storage/uploads and needs persistent disk in production; s3 uses an S3-compatible provider.
STORAGE_DRIVER="local"
# Optional S3 API endpoint. Leave empty for Amazon S3.
S3_ENDPOINT=""
# Use "auto" for Cloudflare R2, or the region given by your provider.
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL of the bucket or its custom domain; the object key is appended.
S3_PUBLIC_URL=""
# Set true for path-style S3 endpoints such as R2 or SeaweedFS; false for virtual-hosted Amazon S3.
S3_FORCE_PATH_STYLE="true"

# Seed
# Optional initial admin email; defaults to admin@admin.com.
SEED_ADMIN_EMAIL="admin@admin.com"
# Leave commented to generate a random password once, or uncomment and replace with 8+ characters.
# SEED_ADMIN_PASSWORD="replace-with-a-unique-password"

# Themes
# Optional token for premium themes; the selector prompts and saves it in .env.local.
GITHUB_TOKEN=""
