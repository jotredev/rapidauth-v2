# Settings for Docker Compose. Copy this file to docker/.env (optional) and uncomment what you change.
# Docker reads only docker/.env, never the root .env. Without docker/.env the defaults shown here apply.
# Run Compose from this folder: cd docker && docker compose up --build

# Ports
# Host port of the app.
# APP_PORT=3000
# Host port of PostgreSQL (127.0.0.1 only).
# DB_PORT=5432
# Host port of Prisma Studio in the development stack (bun run docker:dev).
# STUDIO_PORT=5555
# Poll for file changes in the development stack; keep true on macOS and Windows.
# DOCKER_DEV_POLLING=true

# Required for production on a server
# Secret used to sign sessions; generate one with: openssl rand -hex 32
# BETTER_AUTH_SECRET=replace-with-a-unique-random-64-character-hex-secret
# Public URL of the app; Caddy (--profile vps) uses it as the site address.
# BETTER_AUTH_URL=http://localhost:3000
# Support and legal contact email address.
# SUPPORT_EMAIL=support@example.invalid

# Email
# Resend API key; when set, Mailpit does not start.
# RESEND_API_KEY=
# Sender address for emails.
# FROM_EMAIL=RapidAuth <onboarding@resend.dev>

# Cloudflare Turnstile (both keys enable it)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# OAuth providers (each pair enables its provider)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# File storage: local, or s3 (also starts the bundled S3 storage with --profile s3)
# STORAGE_DRIVER=local
# S3 endpoint; empty uses AWS S3.
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=rapidauth-avatars
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket.
# S3_PUBLIC_URL=
# true for MinIO-style endpoints.
# S3_FORCE_PATH_STYLE=true

# Scheduled cleanup: a value starts the cron service that calls /api/cron/cleanup daily.
# CRON_SECRET=

# Which proxy header carries the client IP: none, vercel, cloudflare or proxy.
# TRUSTED_PROXY=none

# Error monitoring (Sentry)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
