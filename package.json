{
  "name": "rapidauth-better-auth",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run scripts/ensure-docker-db.ts && bun run lint && concurrently -n \"next,tsc\" -c \"cyan,yellow\" \"next dev --turbopack\" \"bun run scripts/typecheck-watch.ts\"",
    "build": "next build",
    "start": "next start",
    "docker:up": "docker compose -f docker/compose.yaml up --build",
    "docker:down": "docker compose -f docker/compose.yaml down",
    "docker:logs": "docker compose -f docker/compose.yaml logs -f",
    "docker:reset": "docker compose -f docker/compose.yaml down -v",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "deps:check": "bun run scripts/check-exact-versions.ts",
    "test:e2e": "playwright test",
    "test:e2e:db": "DB_PORT=55432 docker compose -p rapidauth-e2e -f docker/compose.yaml up -d db",
    "prepare": "husky",
    "init:setup": "bun run scripts/setup.ts",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:switch": "bun run scripts/setup.ts --only database",
    "db:migrate": "bunx prisma migrate dev",
    "db:studio": "bunx prisma studio",
    "db:seed": "bun run scripts/seed.ts",
    "theme:select": "bun run scripts/select-theme.ts",
    "theme:sync-classic": "bun run scripts/sync-classic-theme.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-aspect-ratio": "1.2.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-menubar": "1.2.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@react-email/components": "1.0.12",
    "better-auth": "1.7.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "gsap": "3.15.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-resizable-panels": "4.14.5",
    "recharts": "2.15.4",
    "resend": "6.34.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "10.0.6",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "husky": "9.1.7",
    "prisma": "7.10.1",
    "react-email": "5.2.9",
    "shadcn": "4.22.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
