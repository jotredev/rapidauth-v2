{
  "name": "rapidauth-better-auth",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run scripts/dev-setup.ts && bun run lint && concurrently -n \"next,tsc\" -c \"cyan,yellow\" \"next dev --turbopack\" \"bun run scripts/typecheck-watch.ts\"",
    "build": "next build",
    "start": "next start",
    "docker:dev": "docker compose -f compose.dev.yaml up --build",
    "docker:down": "docker compose -f compose.dev.yaml down",
    "docker:logs": "docker compose -f compose.dev.yaml logs -f",
    "docker:reset": "docker compose -f compose.dev.yaml down -v",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "deps:check": "bun run scripts/check-exact-versions.ts",
    "email:preview": "email dev --dir emails --port 3200",
    "storage:migrate": "bun run scripts/migrate-storage.ts",
    "prepare": "husky",
    "setup:prod": "bun run scripts/setup.ts",
    "setup:sentry": "bun run scripts/setup.ts --only sentry",
    "setup:cleanup": "bun run scripts/setup.ts --only cleanup",
    "setup:proxy": "bun run scripts/setup.ts --only proxy",
    "setup:support": "bun run scripts/setup.ts --only support",
    "db:generate": "bunx prisma generate",
    "db:deploy": "bunx prisma migrate deploy",
    "db:switch": "bun run scripts/setup.ts --only database",
    "db:migrate": "bunx prisma migrate dev",
    "db:studio": "bunx prisma studio",
    "db:seed": "bun run scripts/seed.ts",
    "theme:select": "bun run scripts/select-theme.ts",
    "theme:sync-classic": "bun run scripts/sync-classic-theme.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@hookform/resolvers": "5.9.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nextjs": "11.8.0",
    "better-auth": "1.7.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "gsap": "3.15.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "nextjs-toploader": "3.9.17",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-email": "6.11.3",
    "react-hook-form": "7.90.0",
    "react-resizable-panels": "4.14.5",
    "recharts": "3.10.1",
    "resend": "6.34.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@react-email/ui": "6.11.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "10.0.6",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "husky": "9.1.7",
    "prisma": "7.10.1",
    "shadcn": "4.22.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
